# Browser-safe Supabase project settings. The anon/publishable key is public;
# table access must remain protected by RLS. Static HTML does not read this file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_AUTH_ENABLED=false

# Server-only. Never place this value in HTML, JavaScript served to browsers,
# a public config file, or LocalStorage.
SUPABASE_SERVICE_ROLE_KEY=

# Keep the existing Gemini credential server-side as well.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MATH_TUTOR_ALLOWED_ORIGINS=
